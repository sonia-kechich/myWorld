<?xml version="1.0" encoding="utf-8"?>
<!--
    The vault is only ever copied by the user, through the encrypted export file.
    Android's own cloud backup and device transfer stay switched off, so the
    encrypted records are never uploaded anywhere without the user choosing it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
